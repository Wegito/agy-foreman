{
  "name": "agy-foreman",
  "version": "0.0.1",
  "description": "Verified, approval-gated delegation from Claude Code (or any MCP agent) to Gemini 3.8 Flash via the Antigravity CLI.",
  "type": "module",
  "bin": {
    "agy-foreman": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "mcp",
    "claude-code",
    "antigravity",
    "agy",
    "gemini",
    "delegation"
  ],
  "author": "Mountaser Halak (https://mountaserhalak.com)",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.8.4",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
